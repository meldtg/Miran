# Разрешенные хосты для Django (через запятую)
# Для разработки используйте localhost, для продакшена укажите ваши домены
ALLOWED_HOSTS="localhost,127.0.0.1"

# Токен вашего Telegram бота, получите его у @BotFather
BOT_TOKEN="1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"

# Настройки подключения к PostgreSQL
# Хост базы данных
DB_HOST="localhost"
# Имя базы данных
DB_NAME="db_name"
# Пароль для доступа к базе данных
DB_PASSWORD="your_db_password"
# Порт PostgreSQL (стандартный: 5432)
DB_PORT="5432"
# Имя пользователя базы данных
DB_USER="postgres"

# Режим отладки Django (True для разработки, False для продакшена)
DEBUG="True"

# Секретный ключ Django (обязательно измените в продакшене!)
# Используется для криптографических операций
SECRET_KEY="django-insecure-example-key-change-this-in-production"

# Настройки Redis
# Пароль для подключения к Redis
REDIS_PASSWORD="your_redis_password"
# Полный URL подключения к Redis
REDIS_URL="redis://default:your_redis_password@localhost:6379"
# Порт Redis (стандартный: 6379)
REDISPORT="6379"
# Пользователь Redis
REDISUSER="default"

# Настройки безопасности
# Разрешить доступ всем пользователям (False для ограничения доступа)
ALLOW_ALL_USERS="False"
# Список разрешенных Telegram ID пользователей через запятую
# Получить свой ID можно у @userinfobot
ALLOWED_USER_IDS="123456789,987654321"